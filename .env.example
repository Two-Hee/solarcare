# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# 앱키/시크릿은 절대 채팅·이슈·커밋에 붙여넣지 마세요.

# 한국투자증권 Open API (모의투자용 앱키/시크릿을 발급받아 사용)
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌번호 (예: 50123456-01)
KIS_ACCOUNT_NO=
# mock(모의투자, 기본) | real(실전: 아래 ALLOW 변수 없이는 차단됨)
KIS_MODE=mock

# 선택: 매일 복기(AI 분석)에 사용
ANTHROPIC_API_KEY=
# REVIEW_MODEL=claude-opus-5-5
